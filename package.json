{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "description": "End-to-End UI & API Test Automation Framework built with Playwright, TypeScript, Page Object Model (POM), Faker.js, Allure, and GitHub Actions CI/CD.",
  "author": "Hatim Vasanwala",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=setup --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  }
}
